{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "avr",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/frontend"
            },
            "index": "src/index.html",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              },
              "src/favicon.ico",
              "src/robots.txt",
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor",
                "output": "./assets/monaco-editor"
              }
            ],
            "styles": [
              {
                "input": "src/main.scss",
                "inject": true
              },
              {
                "input": "src/highlightjs/material-light.scss",
                "inject": true
              },
              {
                "inject": true,
                "input": "src/assets/pink-bluegrey.css",
                "bundleName": "pink-bluegrey"
              },
              {
                "inject": true,
                "input": "src/assets/deeppurple-amber.css",
                "bundleName": "deeppurple-amber"
              },
              {
                "inject": true,
                "input": "src/assets/indigo-pink.css",
                "bundleName": "indigo-pink"
              },
              {
                "inject": true,
                "input": "src/assets/purple-green.css",
                "bundleName": "purple-green"
              }
            ],
            "scripts": ["node_modules/marked/marked.min.js"],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "namedChunks": false,
              "extractLicenses": true
            },
            "beta": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.beta.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "namedChunks": false,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "frontend:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "frontend:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              {
                "input": "src/main.scss",
                "inject": true
              },
              {
                "input": "src/highlightjs/material-light.scss",
                "inject": true
              },
              {
                "inject": true,
                "input": "src/assets/pink-bluegrey.css",
                "bundleName": "pink-bluegrey"
              },
              {
                "inject": true,
                "input": "src/assets/deeppurple-amber.css",
                "bundleName": "deeppurple-amber"
              },
              {
                "inject": true,
                "input": "src/assets/indigo-pink.css",
                "bundleName": "indigo-pink"
              },
              {
                "inject": true,
                "input": "src/assets/purple-green.css",
                "bundleName": "purple-green"
              }
            ],
            "scripts": [],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              },
              "src/favicon.ico"
            ]
          }
        }
      }
    },
    "frontend-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular/build:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "frontend:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "frontend:serve:production"
            }
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "avr",
      "style": "css"
    },
    "@schematics/angular:directive": {
      "prefix": "avr"
    }
  },
  "cli": {
    "analytics": "7c97ef82-6e05-4ea4-9604-8dd942812a00"
  }
}
